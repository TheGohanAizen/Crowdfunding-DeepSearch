SEARCH_PROVIDER=auto
HOST=0.0.0.0
PORT=8080
ALLOWED_ORIGIN=http://localhost:8000
GOOGLE_CSE_API_KEY=replace_me
GOOGLE_CSE_ID=replace_me
MAX_SOURCE_CHECKS=8
MAX_DISCOVERY_RESULTS=25

# Automation remains non-live by default. For a genuinely mounted persistent disk only:
AUTOMATION_STORAGE_BACKEND=sqlite
AUTOMATION_STORAGE_PERSISTENT=false
# AUTOMATION_STORAGE_PERSISTENT_ROOT=/var/data
# AUTOMATION_LEDGER_PATH=/var/data/crowdfunding-deepsearch-automation.sqlite3
